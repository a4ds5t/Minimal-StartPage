{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site at start.soholocal.nl: worker routes / and /app; ASSETS serves the rest.
  // `.assetsignore` drops repo docs and tooling from upload.
  "name": "minimal-startpage",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "start.soholocal.nl",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
